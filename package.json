{
  "name": "moonlight-os",
  "version": "2.0.0",
  "description": "MOONLIGHT OS desktop browser with Scramjet and a same-host Wisp relay",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "format": "prettier --write .",
    "lint": "eslint ./src/",
    "lint:fix": "eslint ./src/ --fix",
    "check": "node --check src/index.js && node --check src/basic.js && node --check public/app.js"
  },
  "keywords": [
    "proxy"
  ],
  "author": "Mercury Workshop",
  "license": "GNU AFFERO",
  "dependencies": {
    "fastify": "^5.7.4",
    "@fastify/static": "^9.0.0",
    "@mercuryworkshop/bare-mux": "^2.1.9",
    "@mercuryworkshop/libcurl-transport": "^1.5.2",
    "@mercuryworkshop/scramjet": "https://github.com/MercuryWorkshop/scramjet/releases/download/v1.1.0/mercuryworkshop-scramjet-1.1.0.tgz",
    "@mercuryworkshop/wisp-js": "^0.4.1",
    "ws": "^8.18.3",
    "cheerio": "1.1.2"
  },
  "devDependencies": {
    "eslint": "^9.13.0",
    "prettier": "^3.3.3"
  },
  "packageManager": "pnpm@10.18.3"
}
